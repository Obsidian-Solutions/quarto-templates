	"Obsidian invoice front matter": {
		"prefix": "obs-invoice",
		"body": [
			"---",
			"title: \"${1:Invoice}\"",
			"author: \"${2:Your Name}\"",
			"date: \"${3:2026-08-14}\"",
			"lang: en-GB",
			"reference: \"${4:OS-INV-001}\"",
			"version: \"1.0.0\"",
			"confidentiality: \"${5:Commercial in Confidence}\"",
