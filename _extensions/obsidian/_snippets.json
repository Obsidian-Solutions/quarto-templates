			"    - description: \"${13:Service}\"",
			"      quantity: ${14:1}",
			"      unit-price: ${15:100.00}",
			"  payment:",
			"    provider: ${16:stripe}",
			"    link: \"${17:https://pay.example.com/invoice}\"",
			"  vat-status: \"Not registered for VAT\"",
			"format:",
			"  obsidian-pdf: default",
			"---",
			"",
			"::: {.obsidian-invoice}",
			":::", 
