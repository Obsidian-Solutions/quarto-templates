% SPDX-License-Identifier: MIT
% Hyperlink and PDF metadata setup.
% This partial replaces Quarto's hypersetup.latex so the PDF file
% itself carries the document-control fields, not just the visible
% cover. Variables from the front matter interpolate here.
% Fallback for those not using the hyperref driver hyperxmp:
\makeatletter
\@ifundefined{xmpquote}{\newcommand{\xmpquote}[1]{#1}}{}
\makeatother
\hypersetup{
$if(title-meta)$
  pdftitle={$title-meta$},
$endif$
$if(author-meta)$
  pdfauthor={$author-meta$},
$endif$
$if(lang)$
  pdflang={$lang$},
$endif$
$if(subject)$
  pdfsubject={$subject$},
$endif$
$if(keywords)$
  pdfkeywords={$for(keywords)$\xmpquote{$keywords$}$sep$, $endfor$},
$endif$
$if(colorlinks)$
  colorlinks=true,
  linkcolor={$if(linkcolor)$$linkcolor$$else$obsidianlink$endif$},
  filecolor={$if(filecolor)$$filecolor$$else$obsidianlink$endif$},
  citecolor={$if(citecolor)$$citecolor$$else$obsidianlink$endif$},
  urlcolor={$if(urlcolor)$$urlcolor$$else$obsidianlink$endif$},
$else$
$if(boxlinks)$
$else$
  hidelinks,
$endif$
$endif$
$if(reference)$
  % Document control identity, written to the XMP dc:source field
  % (the pdfmanagement metadata path drops custom Info keys).
  pdfsource={\xmpquote{$reference$}$if(version)$ v$version$$endif$$if(baseline)$ @ $baseline$$endif$},
$endif$
  pdfcreator={LaTeX via pandoc}}
