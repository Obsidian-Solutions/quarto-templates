{
	"Obsidian letter front matter": {
		"prefix": "obs-letter",
		"body": [
			"---",
			"title: \"${1:Business Letter}\"",
			"author: \"${2:Your Name}\"",
			"date: \"${3:2026-08-14}\"",
			"lang: en-GB",
			"reference: \"${4:OS-LET-001}\"",
			"version: \"1.0.0\"",
			"confidentiality: \"${5:Commercial in Confidence}\"",
			"short-title: \"${6:Business Letter}\"",
			"doc-type: \"Letter\"",
			"edition: \"First Edition\"",
			"toc: false",
			"number-sections: false",
			"letter:",
			"  address:",
			"    - \"${7:Recipient Name}\"",
			"    - \"${8:Street Address}\"",
			"    - \"${9:Town, Postcode}\"",
			"  subject: \"${10:Letter subject}\"",
			"  opening: \"${11:Dear Recipient,}\"",
			"  closing: \"${12:Yours sincerely,}\"",
			"format:",
			"  obsidian-pdf: default",
			"  obsidian-html: default",
			"  obsidian-docx: default",
			"---",
			"",
			"# Body",
			"",
			"Write the letter here.",
			""
		],
		"description": "Obsidian house letter front matter."
	},
